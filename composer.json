{
    "name": "jooosi\/icon",
    "description": "Jooosi Icon for WordPress with Iconify, custom SVGs, and page-builder integrations",
    "type": "wordpress-plugin",
    "version": "1.0.0",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "enshrined\/svg-sanitize": "^0.22.0",
        "nabasa\/vp-wp": "^0.3.0",
        "psr\/cache": "^3.0",
        "psr\/container": "^2.0",
        "psr\/log": "^3.0",
        "symfony\/cache": "^6.4",
        "symfony\/dependency-injection": "^6.4",
        "symfony\/http-client": "^6.4",
        "symfony\/mime": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "JooosiIcon\\": "src\/"
        },
        "files": [
            "constant.php"
        ],
        "exclude-from-classmap": [
            "\/src\/Integration\/Breakdance\/Elements\/"
        ]
    },
    "extra": {
        "discovery": {
            "exclude": [
                "src\/Integration\/Bricks\/Elements",
                "src\/Integration\/Breakdance\/Elements",
                "src\/Integration\/Elementor\/Widgets",
                "src\/Integration\/ACF\/Fields"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "php-stubs\/wordpress-stubs": "^7.1"
    }
}